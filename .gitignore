# ============================================================
# Repo PRIVADO. Versiona o código + o estado do pipeline e as
# saídas leves em JSON. Fica de fora o que é pesado ou refazível
# a partir das planilhas do Drive.
# ============================================================

# cache das planilhas do Drive: 221 MB de parquet/xlsx, tudo refazível
# rodando o pipeline de novo. Exceção: os dois JSON abaixo NÃO são cache,
# são a memória do pipeline (histórico semanal congelado) e não têm como
# ser reconstruídos, porque as planilhas-fonte são sobrescritas a cada semana.
_cache/*
!_cache/semanal_snapshots.json
!_cache/headcount_history.json

# saídas do pipeline
bases/*
!bases/semanal_data.json
!bases/semanal_docx.json

# dashboard gerado: entra, é o entregável que se manda no grupo
dashboards/*
!dashboards/dashboard_semanal.html

# planilhas / documentos em qualquer lugar
*.xlsx
*.xls
*.xlsm
*.xlsb
*.docx
*.doc
*.pptx
*.pdf
*.parquet
*.csv
*.pbix

# temporários do Office
~$*

# segredos
.env
.env.*
!.env.example
*.pem
*.key

# ambiente
.venv/
venv/
__pycache__/
*.pyc

# Windows / Google Drive
desktop.ini
Thumbs.db

# ============================================================
# EXCEÇÕES — precisam vir DEPOIS das regras genéricas acima,
# senão o `*.xlsx`/`*.parquet` genérico anula (no git, a última
# regra que casa é a que vale).
# ============================================================
!bases/base_bi.parquet
!bases/base_bi.xlsx
!_docs/**/*.xlsx
_docs/**/~$*
