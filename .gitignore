# ============================================================
# REPO PÚBLICO. Nada de dado do plantel, nome de animal, e-mail
# ou segredo entra aqui. O site é público na internet; o dado
# entra pelo bucket PRIVADO do Supabase, via srcdoc no iframe.
# ============================================================

# ------------------------------------------------------------
# Memória do pipeline. NÃO é cache: as planilhas-fonte do Drive
# são sobrescritas toda semana, então snapshot perdido não se
# reconstrói. Ficou fora do Git quando o repo virou público —
# o backup passou a ser o bucket privado, via
#   python tools/publish_hub.py estado
# ------------------------------------------------------------
_cache/

# saídas do pipeline: JSON com nome de animal, headcount, comprador
bases/

# dashboards gerados (dado do plantel): semanal e auditoria.
# Vao pro bucket, nunca pro site.
dashboards/

# o que os build_*.py geram a partir das bases
assets/semanal/
assets/comite/spec.js
assets/comite/spec.json
# regra por PADRÃO: aba nova nasce protegida mesmo sem ser listada acima
assets/*/dashboard.html

# fotos do relatório mensal — imagem da fazenda em site público
assets/comite/fotos/

# planilhas e bases
*.xlsx
*.xlsm
*.csv
*.parquet
*.pbix
*.pptx

# conteúdo manual extraído do deck aprovado (texto de comentários e manejo)
_docs/comite_conteudo.json
_docs/source_samples/
ComitêHPG/

# seeds com e-mails reais — a allowlist vive no Supabase, não no Git
sql/*.local.sql

# segredos
.env
.env.*
!.env.example
*.pem
*.key

# ambientes
.venv/
__pycache__/
*.pyc
node_modules/
.netlify/

# lixo de sistema
__MACOSX/
.DS_Store
._*
Thumbs.db
desktop.ini
